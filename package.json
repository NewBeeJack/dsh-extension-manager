{
  "name": "dsh-extension-manager",
  "version": "0.4.1",
  "description": "Unified plugin & skill manager for DeepSeek Harness (DSH): inventory, update checks, and safe transactional updates.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/dialog-layout.md",
    "docs/v5-optimization.md",
    "docs/v6-details.md",
    "docs/toolbar-v2.md",
    "docs/v2.1-fixes.md",
    "docs/v3-ui.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "test": "node --test test/plugin-updates.test.ts test/skills.test.ts test/updater.test.ts test/coordinator.test.ts test/repository.test.ts test/toolbar-model.test.ts test/path-model.test.ts test/icon-model.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.7.3",
    "typescript": "^5.9.3",
    "undici": "^7.30.1",
    "yaml": "^2.8.1"
  },
  "author": "NewBeeJack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewBeeJack/dsh-extension-manager.git"
  },
  "homepage": "https://github.com/NewBeeJack/dsh-extension-manager#readme",
  "bugs": {
    "url": "https://github.com/NewBeeJack/dsh-extension-manager/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin-manager",
    "skills",
    "extension-manager",
    "updates"
  ]
}
